generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model entreprise {
  id           Int     @id @default(autoincrement())
  company_name String  @db.VarChar(255)
  offre        offre[]
}

model offre {
  id                 Int                 @id @default(autoincrement())
  title              String              @db.VarChar(255)
  ville              String?             @db.VarChar(255)
  type_contrat       String?             @db.VarChar(100)
  date_publication   DateTime?           @db.Date
  description_courte String?             @db.Text
  description_longue String?             @db.Text
  profil_recherche   String?             @db.Text
  lien_candidature   String?             @db.VarChar(500)
  email_contact      String?             @db.VarChar(255)
  entreprise_id      Int
  entreprise         entreprise          @relation(fields: [entreprise_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_offre_entreprise")
  offre_technologie  offre_technologie[]

  @@index([entreprise_id], map: "fk_offre_entreprise")
}

model offre_technologie {
  offre_id       Int
  technologie_id Int
  offre          offre       @relation(fields: [offre_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_offre_technologie_offre")
  technologie    technologie @relation(fields: [technologie_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_offre_technologie_technologie")

  @@id([offre_id, technologie_id])
  @@index([technologie_id], map: "fk_offre_technologie_technologie")
}

model technologie {
  id                Int                 @id @default(autoincrement())
  technologie_name  String              @db.VarChar(255)
  offre_technologie offre_technologie[]
}
