<%- include('../parts/header') %>
    <div class="mb-8">

        <h1 class="text-2xl font-bold text-gray-900">
            Admin Dashboard
        </h1>

        <p class="text-sm text-gray-500 mt-1">
            Manage companies and technologies
        </p>

    </div>


    <div class="flex justify-end mb-6">

        <a href="offres/offer_form"
            class="bg-indigo-600 text-white px-5 py-2.5 rounded-xl font-medium text-sm flex items-center gap-2 hover:bg-indigo-700 transition shadow-sm">

            <i class="fa-solid fa-plus"></i>

            Create New Offer

        </a>

    </div>


    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">



        <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm">

            <div class="flex items-center gap-3 mb-6">

                <div class="bg-indigo-50 text-indigo-600 w-10 h-10 rounded-xl flex items-center justify-center">

                    <i class="fa-solid fa-building"></i>

                </div>

                <div>

                    <h2 class="font-bold text-gray-900">
                        Ajouter une entreprise
                    </h2>

                    <p class="text-xs text-gray-500">
                        Create a new company
                    </p>

                </div>

            </div>



            <form action="/admin/entreprises" method="POST" class="space-y-4">
                <div>

                    <label for="company_name" class="block text-sm font-medium text-gray-700 mb-2">
                        Nom de l'entreprise
                    </label>

                    <input type="text" id="company_name" name="company_name" placeholder="Ex: Capgemini"
                        class="w-full px-4 py-3 bg-white border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">

                </div>


                <button type="submit"
                    class="w-full bg-indigo-600 text-white px-5 py-3 rounded-xl font-medium text-sm hover:bg-indigo-700 transition">

                    <i class="fa-solid fa-plus mr-2"></i>

                    Ajouter l'entreprise

                </button>

            </form>

        </div>



        <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm">

            <div class="flex items-center gap-3 mb-6">

                <div class="bg-indigo-50 text-indigo-600 w-10 h-10 rounded-xl flex items-center justify-center">

                    <i class="fa-solid fa-code"></i>

                </div>

                <div>

                    <h2 class="font-bold text-gray-900">
                        Ajouter une technologie
                    </h2>

                    <p class="text-xs text-gray-500">
                        Create a new technology
                    </p>

                </div>

            </div>


            <form action="/admin/technologies" method="POST" class="space-y-4">

                <div>

                    <label for="technologie_name" class="block text-sm font-medium text-gray-700 mb-2">
                        Nom de la technologie
                    </label>

                    <input type="text" id="technologie_name" name="technologie_name" placeholder="Ex: React"
                        class="w-full px-4 py-3 bg-white border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">

                </div>


                <button type="submit"
                    class="w-full bg-indigo-600 text-white px-5 py-3 rounded-xl font-medium text-sm hover:bg-indigo-700 transition">

                    <i class="fa-solid fa-plus mr-2"></i>

                    Ajouter la technologie

                </button>

            </form>

        </div>

    </div>
    <section class="max-w-7xl mx-auto px-8 py-8">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="offers-container">
            <% offres.forEach(offer=> { %>

                <div
                    class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition flex flex-col justify-between">

                    <div>

                        <div class="flex items-start justify-between gap-2 mb-3">

                            <h3 class="font-bold text-gray-900 text-base leading-snug">
                                <%= offer.title %>
                            </h3>

                            <a href="/offer_detail/<%= offer.id %>"
                                class="flex items-center gap-1 text-xs text-gray-500 bg-gray-50 border border-gray-200 px-2.5 py-1 rounded-md hover:bg-gray-100 shrink-0">
                                Details
                            </a>
                            
                            <form action="/offer_delete/<%= offer.id %>" method="POST">
                                <button
                                class="flex items-center gap-1 text-xs text-red-500 bg-red-50 border border-red-200 px-2.5 py-1 rounded-md hover:bg-red-100 shrink-0"
                                type="submit">
                                    Delete
                                </button>
                            </form>
                        </div>

                        <p class="text-xs text-gray-500 leading-relaxed mb-6">
                            <%= offer.description_courte %>
                        </p>

                    </div>

                    <div class="flex flex-wrap gap-2">

                        <% offer.offre_technologie.forEach(item=> { %>

                            <span
                                class="bg-indigo-50/70 text-indigo-700 border border-indigo-100 text-xs px-3 py-1.5 rounded-lg font-medium">
                                <%= item.technologie.technologie_name %>
                            </span>

                            <% }) %>

                    </div>

                </div>

                <% }) %>

        </div>
    </section>
    <% - include('../parts/footer') %>