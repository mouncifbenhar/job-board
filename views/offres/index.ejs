<%- include('../parts/header') %>
        <form action="/offers_searsh" method="GET" class="flex gap-3 mb-6">
            <input type="text" name="search" placeholder="Search by offer name"
                class="flex-1 px-4 py-3 border border-gray-200 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500">

            <button type="submit" class="px-5 py-3 bg-indigo-600 text-white rounded-xl hover:bg-indigo-700">
                Search
            </button>
        </form>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="offers-container">
        
        <% offres.forEach(offer=> { %>

            <div
                class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition flex flex-col justify-between">

                <div>

                    <div class="flex items-start justify-between gap-2 mb-3">

                        <h3 class="font-bold text-gray-900 text-base leading-snug">
                            <%= offer.title %>
                        </h3>

                        <button
                            class="flex items-center gap-1 text-xs text-gray-500 bg-gray-50 border border-gray-200 px-2.5 py-1 rounded-md hover:bg-gray-100 shrink-0">
                            <i class="fa-regular fa-bookmark"></i>
                            <span>Follow</span>
                        </button>

                        <a href="/offer_detail/<%= offer.id %>"
                            class="flex items-center gap-1 text-xs text-gray-500 bg-gray-50 border border-gray-200 px-2.5 py-1 rounded-md hover:bg-gray-100 shrink-0">
                            Details
                        </a>

                    </div>

                    <p class="text-xs text-gray-500 leading-relaxed mb-6">
                        <%= offer.description_courte %>
                    </p>

                </div>

                <div class="flex flex-wrap gap-2">

                    <% offer.offre_technologie.forEach(item=> { %>

                        <span
                            class="bg-indigo-50/70 text-indigo-700 border border-indigo-100 text-xs px-3 py-1.5 rounded-lg font-medium">
                            <%= item.technologie.technologie_name %>
                        </span>

                        <% }) %>

                </div>

            </div>

            <% }) %>

    </div>
    <%- include('../parts/footer') %>