<%- include('../parts/header') %>

<div class="max-w-4xl mx-auto px-6 py-10">

    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8">

        <div class="mb-8">
            <h1 class="text-2xl font-bold text-gray-900">
                Create New Offer
            </h1>

            <p class="text-gray-500 mt-2">
                Ajouter une nouvelle offre de stage ou d'alternance.
            </p>
        </div>


        <form action="/admin/offres" method="POST" class="space-y-6">


            <!-- Title -->
            <div>
                <label
                    for="title"
                    class="block text-sm font-medium text-gray-700 mb-2">
                    Offer Title
                </label>

                <input
                    type="text"
                    id="title"
                    name="title"
                    required
                    maxlength="80"
                    placeholder="Ex: Frontend React Developer"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg
                           focus:outline-none focus:ring-2 focus:ring-blue-500
                           focus:border-blue-500">
            </div>


            <!-- Entreprise -->
            <div>
                <label
                    for="entreprise_id"
                    class="block text-sm font-medium text-gray-700 mb-2">
                    Entreprise
                </label>

                <select
                    id="entreprise_id"
                    name="entreprise_id"
                    required
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg
                           bg-white focus:outline-none focus:ring-2
                           focus:ring-blue-500 focus:border-blue-500">

                    <option value="">
                        Sélectionner une entreprise
                    </option>

                    <% entreprises.forEach(entreprise => { %>

                        <option value="<%= entreprise.id %>">
                            <%= entreprise.company_name %>
                        </option>

                    <% }) %>

                </select>
            </div>


            <!-- Ville -->
            <div>
                <label
                    for="ville"
                    class="block text-sm font-medium text-gray-700 mb-2">
                    Ville
                </label>

                <input
                    type="text"
                    id="ville"
                    name="ville"
                    required
                    maxlength="100"
                    placeholder="Ex: Casablanca"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg
                           focus:outline-none focus:ring-2 focus:ring-blue-500
                           focus:border-blue-500">
            </div>


            <!-- Type contrat -->
            <div>
                <label
                    for="type_contrat"
                    class="block text-sm font-medium text-gray-700 mb-2">
                    Type de contrat
                </label>

                <select
                    id="type_contrat"
                    name="type_contrat"
                    required
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg
                           bg-white focus:outline-none focus:ring-2
                           focus:ring-blue-500 focus:border-blue-500">

                    <option value="">
                        Sélectionner
                    </option>

                    <option value="Stage">
                        Stage
                    </option>

                    <option value="Alternance">
                        Alternance
                    </option>

                </select>
            </div>


            <!-- Description courte -->
            <div>
                <label
                    for="description_courte"
                    class="block text-sm font-medium text-gray-700 mb-2">
                    Description courte
                </label>

                <input
                    type="text"
                    id="description_courte"
                    name="description_courte"
                    required
                    placeholder="Résumé de l'offre"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg
                           focus:outline-none focus:ring-2 focus:ring-blue-500
                           focus:border-blue-500">
            </div>


            <!-- Description longue -->
            <div>
                <label
                    for="description_longue"
                    class="block text-sm font-medium text-gray-700 mb-2">
                    Description longue
                </label>

                <textarea
                    id="description_longue"
                    name="description_longue"
                    rows="8"
                    required
                    placeholder="Description complète de l'offre..."
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg
                           focus:outline-none focus:ring-2 focus:ring-blue-500
                           focus:border-blue-500 resize-y"></textarea>
            </div>


            <!-- Profil recherché -->
            <div>
                <label
                    for="profil_recherche"
                    class="block text-sm font-medium text-gray-700 mb-2">
                    Profil recherché
                </label>

                <textarea
                    id="profil_recherche"
                    name="profil_recherche"
                    rows="5"
                    required
                    placeholder="Profil recherché..."
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg
                           focus:outline-none focus:ring-2 focus:ring-blue-500
                           focus:border-blue-500 resize-y"></textarea>
            </div>


            <!-- Lien candidature -->
            <div>
                <label
                    for="lien_candidature"
                    class="block text-sm font-medium text-gray-700 mb-2">
                    Lien de candidature
                </label>

                <input
                    type="url"
                    id="lien_candidature"
                    name="lien_candidature"
                    placeholder="https://..."
                    required
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg
                           focus:outline-none focus:ring-2 focus:ring-blue-500
                           focus:border-blue-500">
            </div>


            <!-- Email -->
            <div>
                <label
                    for="email_contact"
                    class="block text-sm font-medium text-gray-700 mb-2">
                    Email de contact
                </label>

                <input
                    type="email"
                    id="email_contact"
                    name="email_contact"
                    placeholder="contact@entreprise.com"
                    required
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg
                           focus:outline-none focus:ring-2 focus:ring-blue-500
                           focus:border-blue-500">
            </div>


            <!-- Date publication -->
            <div>
                <label
                    for="date_publication"
                    class="block text-sm font-medium text-gray-700 mb-2">
                    Date de publication
                </label>

                <input
                    type="date"
                    id="date_publication"
                    name="date_publication"
                    required
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg
                           focus:outline-none focus:ring-2 focus:ring-blue-500
                           focus:border-blue-500">
            </div>


            <!-- Technologies -->
            <div>

                <label class="block text-sm font-medium text-gray-700 mb-3">
                    Technologies
                </label>

                <div class="grid grid-cols-2 md:grid-cols-3 gap-3">

                    <% technologies.forEach(technologie => { %>

                        <label
                            class="flex items-center gap-3 p-3 border
                                   border-gray-200 rounded-lg cursor-pointer
                                   hover:bg-gray-50">

                            <input
                                type="checkbox"
                                name="technologies[]"
                                value="<%= technologie.id %>"
                                class="w-4 h-4 text-blue-600
                                       border-gray-300 rounded
                                       focus:ring-blue-500">

                            <span class="text-sm text-gray-700">
                                <%= technologie.technologie_name %>
                            </span>

                        </label>

                    <% }) %>

                </div>

            </div>


            <!-- Buttons -->
            <div class="flex items-center justify-end gap-3 pt-6
                        border-t border-gray-200">

                <a
                    href="/admin"
                    class="px-5 py-2.5 rounded-lg border
                           border-gray-300 text-gray-700
                           hover:bg-gray-50 transition">

                    Cancel

                </a>


                <button
                    type="submit"
                    class="px-5 py-2.5 rounded-lg bg-blue-600
                           text-white font-medium hover:bg-blue-700
                           transition">

                    Create Offer

                </button>

            </div>

        </form>

    </div>

</div>

<%- include('../parts/footer') %>

